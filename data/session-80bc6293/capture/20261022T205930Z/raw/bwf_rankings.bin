                            <!-- Junior, World, World Tour, Olympic Rankings -->
                            <tbody v-if="rankingId == 1 || rankingId == 2 || rankingId == 9 || rankingId == 13 || rankingId == 41 || rankingId == 32 || rankingId == 52">
                            <template v-for="(player, index) in players">
                            <tr :key="'row-' + player.id" :class="{'rank-top': player.rank === 1}">

                                <!-- Qualification - Olympics -->
                                <td v-if="rankingId == 13 || rankingId == 32 || rankingId == 41 || rankingId == 52" class="col-qual">{{player.qual | formatQualification}}</td>

                                <!-- Rank - Olympics -->
                                <td v-if="rankingId == 13 || rankingId == 32 || rankingId == 41" class="col-rank-oly">{{player.rank}}</td>

                                <!-- Rank -->
                                <td v-if="rankingId != 13 && rankingId != 32 && rankingId != 41" class="col-rank">
                                    <div class="col-rank-wrapper">
                                        <span class="protected-rank-icon-slot">
                                            <rank-tooltip v-if="player.protected_rank" variant="green" align="center">
                                                <template v-slot:trigger>
                                                    <img class="protected-rank-icon" src="https://bwfbadminton.com/wp-content/themes/fansite-2020/assets/images/ranking/rank-protected.svg" v-bind:alt="$t('Protected Rank')">
                                                </template>
                                                <strong>{{ $t('Protected Rank') }}</strong>
                                                <ul>
                                                    <li>{{ $t('Rank') }} <strong>{{player.protected_rank | toRank}}</strong></li>
                                                </ul>
                                            </rank-tooltip>
                                        </span>
                                        <span class="rank-value">{{player.rank | toRank}}</span>
                                        <div class="ranking-change-outer">
                                            <span v-if="player.rank_change > 0" class="ranking-change" style="color: green;"><i class="fas fa-2x fa-caret-up"></i> {{player.rank_change | toPosNumber}}</span>
                                            <span v-if="player.rank_change < 0" class="ranking-change" style="color: red;"><i class="fas fa-2x fa-caret-down"></i> {{player.rank_change | toPosNumber}}</span>
                                            <span v-if="player.rank_change == 0" class="ranking-change" style="color: #999; margin-left: 6px;">{{player.rank_change | toPosNumber}}</span>
                                        </div>
                                    </div>

                                <th class="col-player">PLAYER</th>
                                <th class="col-country">NATION</th>
                                <th class="col-tmt">TOURNAMENTS</th>
                                <th class="col-points">POINTS</th>
                                <th class="col-breakdown">BREAKDOWN</th>
                            </tr>


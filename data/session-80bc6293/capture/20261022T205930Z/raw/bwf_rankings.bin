                                <th align="center" valign="middle" class="mobile">MS</th>
                                <th class="mobile" align="center">WS</th>
                                <th class="mobile" align="center">MD</th>
                                <th class="mobile" align="center">WD</th>
                                <th class="mobile" align="center">XD</th>
                                <th class="mobile" align="center">SC</th>
                                <th class="mobile" align="center">TC</th>

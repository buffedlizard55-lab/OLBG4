                                </li>
                                <li :class="{'active': paraTab === 3}" @click="paraTab = 3">
                                    <a href="#" v-on:click.prevent="paraEventChange(145)">
                                        <span>{{ $t("SH6") }}</span>
                                    </a>
                                </li>
                            </ul>

                        </div>

                        <!-- All other rankings -->
                        <ul v-else class="ranking-event-tabs">
                            <li :class="{'active': activeTab === 1}" @click="activeTab = 1">
                                <a href="#" v-on:click.prevent="eventChange(1)">
                                    <span class="ranking-tab-desktop">MEN'S SINGLES</span>
                                    <span class="ranking-tab-mobile">MS</span>
                                </a>
                            </li>
                            <li :class="{'active': activeTab === 2}" @click="activeTab = 2">
                                <a href="#" v-on:click.prevent="eventChange(2)">
                                    <span class="ranking-tab-desktop">WOMEN'S SINGLES</span>
                                    <span class="ranking-tab-mobile">WS</span>

                                                        <td class="breakdown-icon">
                                                            <img v-if="tmt.ranking_calc == 1" src="https://bwfbadminton.com/wp-content/themes/fansite-2020/assets/images/rank_breakdown-01.svg" alt="" />
                                                        </td>

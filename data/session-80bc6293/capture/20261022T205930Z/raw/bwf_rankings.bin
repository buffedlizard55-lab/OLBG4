<script type="text/javascript">

    var $j = jQuery.noConflict();

    $j(document).ready(function () {

        // Add link to mobile menu logo.
        var home_url = 'https://bwfbadminton.com';
		$j('#responsive-menu-title-image img').wrap("<a href=" + home_url + "></a>");

        // Set active menu item.
        function setactivemenu() {
            var siteLanguage = 'en_US';

            // English create active menu link.
            if (siteLanguage == 'en_US') {
                var pathArray = window.location.pathname.split('/');

                if (pathArray[1] == "news" || pathArray[1] == "news-single" || pathArray[1] == "news-tag") {
                    $j("li#menu-news, li.menu-news").addClass("current-menu-item");
                } else if (pathArray[1] == "live") {
                    $j("li#menu-item-111, li.menu-item-111").addClass("current-menu-item");
                } else if (pathArray[1] == "tournament") {
                    $j("li#menu-calendar, li.menu-calendar").addClass("current-menu-item");
                } else if (pathArray[1] == "results") {
                    $j("li#menu-item-335, li.menu-item-335").addClass("current-menu-item");
                } else if (pathArray[1] == "player" || pathArray[1] == "player-titles" || pathArray[1] == "h2h") {
                    $j("li#menu-item-8, li.menu-item-8").addClass("current-menu-item");
                }
            }

            // Chinese create active menu link.
            if (siteLanguage == 'zh_CN') {
                var pathArray = window.location.pathname.split('/');

                if (pathArray[2] == "news" || pathArray[2] == "news-single" || pathArray[2] == "news-tag") {
                    $j("li#menu-news, li.menu-news").addClass("current-menu-item");
                } else if (pathArray[2] == "live") {
                    $j("li#menu-item-182, li.menu-item-182").addClass("current-menu-item");
                } else if (pathArray[2] == "tournament") {
                    $j("li#menu-calendar, li.menu-calendar").addClass("current-menu-item");
                } else if (pathArray[2] == "player" || pathArray[2] == "player-titles" || pathArray[2] == "h2h") {
                    $j("li#menu-item-181, li.menu-item-181").addClass("current-menu-item");
                }
            }

        }

        // Display main nav menu only when page is loaded.
        $j("#navigation").fadeIn('slow');

        // Menu language link.
        function setmenulink() {
            var siteLanguage = 'en_US';

            // English create menu link.
            if (siteLanguage == 'en_US') {
                var pathArray = window.location.pathname.split('/');
                // console.log(pathArray);

                // Redirect single news item to main news page.
                if (pathArray[1] == 'news-single') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/zh-cn/news';

                // Redirect Guangzhou page.
                } else if (pathArray[1] == 'guangzhou-en') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/zh-cn/guangzhou-cn';

                // Redirect tickets page.
                } else if (pathArray[1] == 'tickets-en') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/zh-cn/tickets-cn';

                // Redirect history page.
                } else if (pathArray[1] == 'history-en') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/zh-cn/history-cn';

                // Standard redirect.
                } else {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/zh-cn' + window.location.pathname + window.location.search;
                }
            }

            // Chinese create menu link.
            if (siteLanguage == 'zh_CN') {
                var pathArray = window.location.pathname.split('/');
                // console.log(pathArray);

                // Redirect single news item to main news page.
                if (pathArray[2] == 'news-single') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/news';

                // Redirect Guangzhou page.
                } else if (pathArray[2] == 'guangzhou-cn') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/guangzhou-en';

                // Redirect tickets page.
                } else if (pathArray[2] == 'tickets-cn') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/tickets-en';

                // Redirect history page.
                } else if (pathArray[2] == 'history-cn') {
                    var newUrl = window.location.protocol + '//' + window.location.host + '/history-en';

                // Standard redirect.
                } else {
                    var newPath = "";
                    for (i = 2; i < pathArray.length; i++) {
                        newPath += "/";
                        newPath += pathArray[i];
                    }
                    var newUrl = window.location.protocol + '//' + window.location.host + newPath + window.location.search;
                }
            }

            // Set a href link.
            $j("li.menu-language a").attr("href", newUrl);
            // console.log("New URL: " + newUrl);
        }

        // Set active menu link.
        setactivemenu();
        // Set language menu link.
        setmenulink();

    });  

</script>

<script>
    // Page key
    let rankingsPageKey = sessionStorage.getItem('rankingsPageKey');

    // Ready translated locale messages
    const messages = {
        en: {},
        cn: {
            "BWF World Rankings": "世界羽联官方排名",
            "Race to Tokyo - BWF Olympic Qualification": "里约之路-奥运会资格",
            "HSBC Race to Guangzhou Rankings": "世界巡回赛",
            "BWF Junior Rankings": "世界羽联青年排名",
            "BWF World Team Rankings": "世界羽联团体排名",
            "Indicates results used for ranking calculation.": "指示用于排名计算的结果。",
            "Info/Disclaimer": "更多资讯",
            "Last updated": "上次更新",
            "Search player/country...": "搜索播放器/国家/地区...",
            "Ranking": "排名",
            "Ranking Breakdown": "排名细目",
            "Week": "周",
            "Per page": "每页",
            "entries": "参赛作品",
            "Close": "关闭",
            "Info/Disclaimer": "信息/免责声明",
            "Last Tournament": "上一场比赛",
            "Protected Rank": "保护排名",
            "Rank": "排名",
            "Ranking Overview": "排名概览",
            "New Career High": "最新生涯最佳排名",
            "Career High": "生涯最佳排名",
            "Total": "共",
            "weeks": "周",
            "consecutive weeks": "连续周",
        }
    }

    // Create VueI18n instance with options
    const i18n = new VueI18n({
        locale: 'en', // set locale
        messages, // set locale messages
    })


    const VDialogOriginal = Vue.options.components.VDialog;

    Vue.component('CustomVDialog', {
        extends: VDialogOriginal,
        props: {
            ZIndex: {
                type: Number,
                default: 200,
            },
        },
        data() {
            const originalData = VDialogOriginal.options.data.call(this);

            return {
                ...originalData,
                stackMinZIndex: this.ZIndex,
            };
        },
    });

    Vue.component('rank-tooltip', {
        props: {
            variant: { type: String, default: 'green' }, // green | pink | orange
            align: { type: String, default: 'center' }, // center | left
        },
        data() {
            return {
                isOpen: false,
            };
        },
        methods: {
            toggle() {
                this.isOpen = !this.isOpen;
            },
            close() {
                this.isOpen = false;
            },
            handleOutsideClick(e) {
                if (!this.$el.contains(e.target)) {
                    this.isOpen = false;
                }
            },
        },
        mounted() {
            document.addEventListener('click', this.handleOutsideClick);
        },
        beforeDestroy() {
            document.removeEventListener('click', this.handleOutsideClick);
        },
        template: `
            <span class="rank-tooltip" :class="['variant-' + variant, 'align-' + align]" @mouseleave="close">
                <span class="rank-tooltip-trigger" @click.stop="toggle"><slot name="trigger"></slot></span>
                <div class="rank-tooltip-content" :class="{'is-open': isOpen}"><slot></slot></div>
            </span>
        `,
    });

    // NCH/CH stat badge next to a player's name. The avatar photo always shows at rank 1 when
    // available, independent of whether there's a stat badge; other rows fall back to a plain
    // inline tag when a stat is present, or render nothing.
    Vue.component('player-stat-badge', {
        props: {
            stat: { type: Object, default: null }, // { type: 'NCH'|'CH', total_weeks, consecutive_weeks }
            avatar: { type: Object, default: null },
            slug: { type: String, default: '' },
            showAvatar: { type: Boolean, default: false },
        },
        template: `
            <div v-if="showAvatar && avatar" class="player-avatar-wrap" :class="stat ? 'stat-' + stat.type.toLowerCase() : ''">
                <rank-tooltip v-if="stat" :variant="stat.type === 'NCH' ? 'pink' : 'orange'" align="left">
                    <template v-slot:trigger>
                        <div class="player-avatar">
                            <img :src="avatar.url_cloudinary" :alt="slug">
                        </div>
                        <span class="player-stat-badge">{{stat.type}}</span>
                    </template>
                    <strong>{{stat.type === 'NCH' ? $t('New Career High') : $t('Career High')}}</strong>
                    <ul>
                        <li v-if="stat.total_weeks && stat.type === 'CH'">{{ $t('Total') }} {{stat.total_weeks}} {{ $t('weeks') }}</li>
                        <li v-if="stat.consecutive_weeks">{{stat.consecutive_weeks}} {{ $t('consecutive weeks') }}</li>
                    </ul>
                </rank-tooltip>
                <div v-else class="player-avatar">
                    <img :src="avatar.url_cloudinary" :alt="slug">
                </div>
            </div>
            <rank-tooltip v-else-if="stat" :variant="stat.type === 'NCH' ? 'pink' : 'orange'" align="left" class="player-stat-inline">
                <template v-slot:trigger>
                    <span class="player-stat-tag" :class="'stat-' + stat.type.toLowerCase()">{{stat.type}}</span>
                </template>
                <strong>{{stat.type === 'NCH' ? $t('New Career High') : $t('Career High')}}</strong>
                <ul>
                    <li v-if="stat.total_weeks && stat.type === 'CH'">{{ $t('Total') }} {{stat.total_weeks}} {{ $t('weeks') }}</li>
                    <li v-if="stat.consecutive_weeks">{{stat.consecutive_weeks}} {{ $t('consecutive weeks') }}</li>
                </ul>
            </rank-tooltip>
        `,
    });

    var app = new Vue({
        el: '#app',
        i18n,
        vuetify: new Vuetify({
            theme: {
                themes: {
                    light: {
                        primary: '#df2027',
                        secondary: '#b0bec5',
                        accent: '#8c9eff',
                        error: '#b71c1c',
                    },
                },
            },
        }),
        data: {
            debounceTimer: null,
            extranetUrl: 'https://extranet.bwf.sport',
            extranetLvUrl: 'https://extranet-lv.bwfbadminton.com',
            siteUrl: 'https://bwfbadminton.com',
            activeTab: 1,
            paraTab: 1,
            loading: false,
            loadingHeader: false,
            showModal: {},
            expandedRow: {},
            showModalInfo: {},
            doubles: false,
            // rankingId: 14,
            // rankingKey: "14-82",
            rankingId: 2,
            rankingKey: '2-6',
            rankingWeekKey: "",
            publicationId: 0,
            catId: 147,
            catIdMaster: {
                1: 1,
                2: 6,
                3: 11,
                9: 57,
                13: 77,
                14: 82,
                41: 200,
                30: 147,
                31: 125,
                32: 168,
                52: 240,
            },
            rankingOptions: [
                {
                value: '2-6',
                text: 'BWF World Rankings'
            },
                {
                value: '9-57',
                text: 'BWF World Tour Rankings'
            }, {
                value: '1-1',
                text: 'BWF World Junior Rankings'
            }, {
                value: '3-11',
                text: 'BWF World Team Rankings'
            },
                {
                    value: '52-240',
                    text: 'BWF World Championships Rankings'
                },
                {
                value: '32-168',
                text: 'Olympic Games Qualification'
            }, {
                value: '14-82',
                text: 'BWF Para Badminton World Rankings'
            }, {
                value: '30-147',
                text: 'Paralympic Games Qualification'
            }, {
                value: '31-125',
                text: 'Parapan American Games Qualification'
            }
            ],
            drawCount: '',
            pageKey: rankingsPageKey || "10",
            page: 1,
            players: {},
            searchKey: "",
            pagination: {
                entryStart: 0,
                entryEnd: 0,
                entryTotal: 0,
                currentPage: 0,
                totalPage: 0,
                firstPageUrl: 0,
                lastPageUrl: 0,
                prevPageUrl: 0,
                nextPageUrl: 0,
            },
            breakdown: {},
            rankingInfo: {},
            rankingModel: {},
            rankingWeek: [],
        },
        computed: {
            // Column count for the mobile Points/Tournaments panel's <td colspan>. Must match
            // the number of VISIBLE mobile columns only (Tournaments/Points are display:none at
            // mobile, not absent) — under table-layout:fixed, a hidden column still holds an
            // auto-width slot that competes with .col-player for space, so a colspan that spans
            // through those hidden columns keeps them "in play" and squeezes the visible ones.
            // Stopping the colspan at the last visible column excludes them from that competition.
            mobileExpandColspan() {
                if (this.rankingId == 13 || this.rankingId == 41 || this.rankingId == 52) {
                    return 5; // Qual, Rank, Player, Nation, Breakdown
                }
                if (this.rankingId == 32) {
                    return 5; // Qual, Rank(oly), Player, Nation, Breakdown (pre-existing header/body mismatch for this id)
                }
                return 4; // 1, 2, 9, 14, 30, 31: Rank, Player, Nation, Breakdown
            },
            visiblePages() {
                const total = this.pagination.totalPage;
                const current = this.pagination.currentPage;
                const windowSize = 6;
                let start = Math.max(1, current - Math.floor(windowSize / 2));
                let end = Math.min(total, start + windowSize - 1);
                start = Math.max(1, end - windowSize + 1);

                const pages = [];
                for (let i = start; i <= end; i++) {
                    pages.push(i);
                }
                return pages;
            },
        },
        methods: {
            debouncedGetPlayers(tabSelected) {
                clearTimeout(this.debounceTimer);
                this.debounceTimer = setTimeout(() => {
                    this.getPlayers(tabSelected);
                }, 800);
            },
            getRanking(rankingId = this.rankingId) {
                axios({
                    url: this.extranetLvUrl + '/api/vue-rankingdata',
                    method: 'get',
                    params: {
                        rankId: this.rankingId,
                    }
                })
                    .then(response => {
                        let data = response.data[0];
                        // console.log('Ranking data: ', data);
                        this.rankingModel = data;
                    })
                    .catch(errors => {
                        console.log('Ranking errors: ', errors);
                    });
            },
            getRankingWeek(rankingId = this.rankingId) {
                axios({
                    url: this.extranetLvUrl + '/api/vue-rankingweek',
                    method: 'get',
                    params: {
                        rankId: this.rankingId,
                    }
                })
                    .then(response => {
                        let data = response.data;
                        // console.log('Ranking week: ', data);
                        this.rankingWeek = data;
                        this.rankingWeekKey = data[0].key;
                    })
                    .catch(errors => {
                        console.log('Ranking week errors: ', errors);
                    });
            },
            getPlayers(tabSelected = this.activeTab) {
                this.loading = true;
                switch (tabSelected) {
                    case 1:
                    case 2:
                        this.doubles = false;
                        if (this.rankingId != 14 && this.rankingId != 30 && this.rankingId != 31  ) {
                            this.catId = this.catIdMaster[this.rankingId] + (tabSelected - 1);
                        }
                        break;
                    case 3:
                    case 4:
                    case 5:
                        if (this.rankingId == 1) {
                            this.doubles = false;
                        } else {
                            this.doubles = true;
                        }
                        if (this.rankingId != 14 && this.rankingId != 30 && this.rankingId != 31 ) {
                            this.catId = this.catIdMaster[this.rankingId] + (tabSelected - 1);
                        }
                        break;
                }
                this.drawCount++;
                // console.log('catId: ', this.catId);

                axios({
                    url: this.extranetLvUrl + '/api/vue-rankingtable',
                    method: 'get',
                    params: {
                        rankId: this.rankingId,
                        catId: this.catId,
                        publicationId: this.publicationId,
                        doubles: this.doubles,
                        searchKey: this.searchKey,
                        pageKey: this.pageKey,
                        page: this.page,
                        drawCount: this.drawCount,
                    }
                })
                    .then(response => {
                        let data = response.data;
                        // console.log("Ranking Data: ", data);
                        if (this.drawCount == data.drawCount) {
                            this.players = data.results.data;
                            this.pagination.entryStart = data.results.from || 0;
                            this.pagination.entryEnd = data.results.to || 0;
                            this.pagination.entryTotal = data.results.total || 0;
                            this.pagination.currentPage = data.results.current_page || 1;
                            this.pagination.totalPage = data.results.last_page || 1;
                            this.pagination.firstPageUrl = data.results.first_page_url || 0;
                            this.pagination.lastPageUrl = data.results.last_page_url || 0;
                            this.pagination.nextPageUrl = data.results.next_page_url || 0;
                            this.pagination.prevPageUrl = data.results.prev_page_url || 0;
                            this.loading = false;
                            this.loadingHeader = false;
                        }
                    })
                    .catch(errors => {
                        console.log(errors);
                    });
            },
            perpageChange(selectValue) {
                sessionStorage.setItem('rankingsPageKey', selectValue)
                this.pageKey = selectValue;
                this.page = 1;
                this.getPlayers();
            },
            rankingChange(selectValue) {
                this.loadingHeader = true;
                setTimeout(() => {
                    selectSplit = selectValue.split('-');
                    console.log(selectSplit);

                    this.rankingId = parseInt(selectSplit[0], 10);
                    this.catId = parseInt(selectSplit[1], 10);
                    console.log("Ranking ID: ", this.rankingId);
                    console.log("Cat ID: ", this.catId);

                    // Push URL.
                    history.pushState({}, "", '/rankings/?id=' + this.rankingId);

                    this.publicationId = 0;
                    this.doubles = false;
                    this.activeTab = 1;
                    this.page = 1;
                    this.getRanking();
                    this.getRankingWeek();
                    this.getPlayers(1);
                }, 100);
            },
            splitWeekLabel(display) {
                if (!display) {
                    return { weekPart: '', datePart: '' };
                }
                const match = display.match(/^(.*?)(\(.*\))\s*$/);
                if (match) {
                    return { weekPart: match[1].trim(), datePart: match[2] };
                }
                return { weekPart: display, datePart: '' };
            },
            rankingWeekChange(selectValue) {
                selectSplit = selectValue.split('-');
                this.publicationId = parseInt(selectSplit[2], 10);
                this.doubles = false;
                this.activeTab = 1;
                this.page = 1;
                // this.getRanking();
                // this.getRankingWeek();
                this.getPlayers(1);
            },
            eventChange(selectValue) {
                this.page = 1;

                // Check for para ranking.
                if (this.rankingId == 14) {
                    this.paraTab = 1;
                    if (selectValue == 1) {
                        this.catId = 82;
                    } else if (selectValue == 2) {
                        this.catId = 83;
                    } else if (selectValue == 3) {
                        this.catId = 84;
                    } else if (selectValue == 4) {
                        this.catId = 85;
                    } else if (selectValue == 5) {
                        this.catId = 86;
                    } else if (selectValue == 6) {
                        this.catId = 119;
                    }
                }
                if (this.rankingId == 30) {
                    this.paraTab = 1;
                    if (selectValue == 1) {
                        this.catId = 147;
                    } else if (selectValue == 2) {
                        this.catId = 148;
                    } else if (selectValue == 3) {
                        this.catId = 149;
                    } else if (selectValue == 4) {
                        this.catId = 150;
                    } else if (selectValue == 5) {
                        this.catId = 158;
                    } else if (selectValue == 6) {
                        this.catId = 119;
                    }
                }
                if (this.rankingId == 31) {
                    this.paraTab = 1;
                    if (selectValue == 1) {
                        this.catId = 125;
                    } else if (selectValue == 2) {
                        this.catId = 129;
                    } else if (selectValue == 3) {
                        this.catId = 127;
                    } else if (selectValue == 4) {
                        this.catId = 130;
                    } else if (selectValue == 5) {
                        this.catId = 131;
                    } else if (selectValue == 6) {
                        this.catId = 119;
                    }
                }
                this.getPlayers(selectValue);
            },
            paraEventChange(selectValue) {
                this.page = 1;
                this.catId = selectValue;
                this.getPlayers(this.activeTab);
            },
            goNextPage() {
                this.page++;
                // this.$router.push({path:'/?page=' + this.page })
                this.getPlayers();
            },
            goPrevPage() {
                this.page--;
                // this.$router.push({path:'/?page=' + this.page })
                this.getPlayers();
            },
            goToPage(pageNum) {
                if (pageNum === this.pagination.currentPage) {
                    return;
                }
                this.page = pageNum;
                this.getPlayers();
            },
            showModalBreakdown(player) {
                axios({
                    url: this.extranetLvUrl + '/api/vue-rankingbreakdown',
                    method: 'get',
                    params: {
                        rankId: this.rankingId,
                        catId: this.catId,
                        playerData: player,
                    }
                })
                    .then(response => {
                        this.breakdown = response.data;
                        console.log('Breakdown data: ', this.breakdown);
                    })
                    .catch(errors => {
                        console.log('Breakdown errors: ', errors);
                    });
            },
            closeModalBreakdown() {
                this.breakdown = {};
            },
            showModalRankingInfo(player) {
                axios({
                    url: this.extranetLvUrl + '/api/vue-rankinginfo',
                    method: 'get',
                    params: {
                        rankId: this.rankingId,
                        siteLanguage: 'en_US',
                    }
                })
                    .then(response => {
                        this.rankingInfo = response.data;
                        // console.log('rankingInfo: ', this.rankingInfo);
                    })
                    .catch(errors => {
                        console.log('rankingInfo errors: ', errors);
                    });
            },
            closeModalRankingInfo() {
                // this.breakdown = {};
            },
            setLanguage() {
                let siteLanguage = 'en_US';
                if (siteLanguage == "zh_CN") {
                    i18n.locale = 'cn';
                }
            },
            getLinkWithLocale(url = '') {
                if (!url) return '';
                const siteLanguage = 'en_US';

                if (siteLanguage == "zh_CN") {
                    const newUrl = new URL(url);
                    newUrl.pathname = `/zh-cn${newUrl.pathname}`
                    return newUrl.href
                }

                return url
            }
        },
        filters: {
            formatQualification(value) {
                if (value === 999) {
                    return '-';
                } else {
                    return value;
                }
            },
            toCurrency(value) {
                return '$' + Number(value).toLocaleString();
            },
            toInteger(value) {
                return Math.round(value).toLocaleString();
            },
            toNumber(value) {
                return Number(value).toLocaleString();
            },
            toRank(value) {
                return String(value).padStart(2, '0');
            },
            toPosNumber(value) {
                if (value == 0) {
                    return '-';
                } else {
                    return Math.abs(value);
                }
            },
            toDate(value) {
                // let date = new Date(value);
                let date = new Date(value.replace(/-/g, "/"));
                let dateString = new Date(date.getTime() - (date.getTimezoneOffset() * 60000))
                    .toISOString()
                    .split("T")[0];
                return dateString;
            },
            toResult(value) {
                switch (value) {
                    case 3:
                        value = '3/4';
                        break;
                    case 5:
                        value = '5/8';
                        break;
                    case 9:
                        value = '9/16';
                        break;
                    case 17:
                        value = '17/32';
                        break;
                    case 33:
                        value = '33/64';
                        break;
                }
                return value;
            },
        },
        created() {
            this.setLanguage();
            this.getRankingWeek();
            this.getRanking();
            this.catId = this.catIdMaster[this.rankingId];
            this.getPlayers(1);
        }
    });
</script>

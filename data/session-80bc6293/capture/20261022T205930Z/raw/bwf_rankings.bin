                                        <span>{{ $t("WH1-WH2") }}</span>
                                    </a>
                                </li>
                                <li :class="{'active': paraTab === 2}" @click="paraTab = 2">
                                    <a href="#" v-on:click.prevent="paraEventChange(136)">
                                        <span>{{ $t("SL3-SU5") }}</span>
                                    </a>
                                </li>
                                <li :class="{'active': paraTab === 3}" @click="paraTab = 3">
                                    <a href="#" v-on:click.prevent="paraEventChange(144)">
                                        <span>{{ $t("SH6") }}</span>
                                    </a>
                                </li>
                            </ul>

                            <!-- XD -->
                            <ul v-if="activeTab == 5" class="ranking-event-tabs ranking-event-tabs-row2">
                                <li :class="{'active': paraTab === 1}" @click="paraTab = 1">
                                    <a href="#" v-on:click.prevent="paraEventChange(131)">
                                        <span>{{ $t("WH1-WH2") }}</span>
                                    </a>
                                </li>
                                <li :class="{'active': paraTab === 2}" @click="paraTab = 2">
                                    <a href="#" v-on:click.prevent="paraEventChange(137)">
                                        <span>{{ $t("SL3-SU5") }}</span>

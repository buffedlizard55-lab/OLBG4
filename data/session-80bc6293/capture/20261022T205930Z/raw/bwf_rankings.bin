                                <td class="col-team-points" align="center">{{player.team_xd | toNumber}}</td>
                                <td class="col-team-points" align="center">{{player.team_sc | toNumber}}</td>
                                <td class="col-team-points" align="center">{{player.team_tc | toNumber}}</td>
                                <td class="col-team-points" align="center">{{player.team_uc | toNumber}}</td>
                                <td class="col-team-total" align="center">{{player.team_total_points | toNumber}}</td>
                            </tr>
                            </tbody>
                        </table>

                        <!-- Pagination -->
                        <div class="table-search-row">
                            <div class="table-page-results">
                                <span class="entries-summary">
                                    <strong>{{pagination.entryStart}}-{{pagination.entryEnd}}</strong>
                                    <span class="entries-divider">|</span>
                                    <strong>{{pagination.entryTotal}} {{ $t('entries') }}</strong>
                                </span>
                                <div class="table-ranking-disclaimer">
                                    <a href="#" @click.prevent="$set(showModalInfo, rankingId, true), showModalRankingInfo(rankingId)">
                                        <i class="fas fa-fw fa-info-circle"></i> {{ $t("Info/Disclaimer") }}
                                    </a>
                                </div>

                                <v-dialog v-model="showModalInfo[rankingId]" max-width="900" scrollable>

                                    <v-card>
                                        <v-card-title class="headline grey lighten-2 justify-space-between">
                                            {{ $t("Info/Disclaimer") }}
                                            <v-btn icon @click.stop="$set(showModalInfo, rankingId, false), closeModalRankingInfo()">
                                                <v-icon>mdi-close</v-icon>
                                            </v-btn>
                                        </v-card-title>

                                        <v-card-text>
                                            <div v-if="rankingInfo" class="card-text">

                                                <!-- Ranking text -->
                                                <span v-safe-html:rich="this.rankingInfo.info_text"></span>

                                                <!-- Last updated text -->
                                                <p v-if="rankingWeek[0]">
                                                    {{ $t("Last updated") }}: <strong>{{rankingWeek[0].date | toDate}}</strong>
                                                </p>

                                                <!-- Last tournament text -->
                                                <p>
                                                    {{ $t("Last Tournament") }}: <strong>{{this.rankingInfo.last_tournament}}</strong>
                                                </p>
                                            </div>
                                        </v-card-text>

                                        <v-divider></v-divider>

                                        <v-card-actions>
                                            <v-spacer></v-spacer>
                                            <v-btn color="primary" text @click.stop="$set(showModalInfo, rankingId, false), closeModalRankingInfo()">
                                                {{ $t("Close") }}
                                            </v-btn>
                                        </v-card-actions>

                                    </v-card>
                                </v-dialog>


                            </div>
                            <div class="table-pagination">
                                <nav class="pagination">
                                    <a v-if="pagination.prevPageUrl" class="page-nav" @click="goPrevPage()">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>
                                    <a v-else :disabled="true" class="page-nav disabled">
                                        <i class="fas fa-chevron-left"></i>
                                    </a>

                                    <a v-for="pageNum in visiblePages" :key="pageNum" class="page-number" :class="{'active': pageNum === pagination.currentPage}" @click="goToPage(pageNum)">
                                        {{pageNum}}
                                    </a>

                                    <a v-if="pagination.nextPageUrl" class="page-nav" @click="goNextPage()">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                    <a v-else :disabled="true" class="page-nav disabled">
                                        <i class="fas fa-chevron-right"></i>
                                    </a>
                                </nav>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </template>
    </v-app>
</div>



    <script nonce="33b66cfa-51f6-4124-8992-ba7ee8ec0ab0" defer>
    window.googletag = window.googletag || { cmd: [] };

    window.__adConsentGranted = false;
    window.__gptReady = false;
    window.__gptQueue = window.__gptQueue || [];

    googletag["slots"] = [];

    function initGPT() {
		const gptSrc = window.__adConsentGranted
        ? "https://securepubads.g.doubleclick.net/tag/js/gpt.js"
        : "https://pagead2.googlesyndication.com/tag/js/gpt.js";
      
        const gptScript = document.createElement("script");
        gptScript.async = true;
        gptScript.src = gptSrc;
        gptScript.nonce = "33b66cfa-51f6-4124-8992-ba7ee8ec0ab0";
        document.head.appendChild(gptScript);

        googletag.cmd.push(function () {
            googletag.pubads().setForceSafeFrame(true);


            if (!window.__adConsentGranted) {
               googletag.pubads().setPrivacySettings({
				nonPersonalizedAds: true,    
				restrictDataProcessing: true,
				limitedAds: true             
			  });
            }

            



    
        googletag.slots['div-gpt-ad-Header'] = googletag.defineSlot('/21840952109/Header', [728,90], 'div-gpt-ad-Header')
        .defineSizeMapping(googletag.sizeMapping().addSize([728, 0],  [728,90]).addSize([0, 0], [320,50] ).build())
        .setCollapseEmptyDiv(true)
        .setTargeting('Position', ['ATP Header'])
        .addService(googletag.pubads());
    
    
        googletag.slots['div-gpt-ad-Footer'] = googletag.defineSlot('/21840952109/Footer', [728,90], 'div-gpt-ad-Footer')
        .defineSizeMapping(googletag.sizeMapping().addSize([728, 0],  [728,90]).addSize([0, 0], [320,50] ).build())
        .setCollapseEmptyDiv(true)
        .setTargeting('Position', ['ATP Footer'])
        .addService(googletag.pubads());
    


            googletag.pubads().enableSingleRequest();
            googletag.pubads().collapseEmptyDivs();

            googletag.pubads().
                setTargeting('Language', ['English']).
                setTargeting('Site', ['ATP Tour']).
                setTargeting('Device', ['Desktop']);

            googletag.enableServices();
            window.__gptReady = true;
            window.__gptQueue.forEach(function (fn) { fn(); });
            window.__gptQueue = [];
        });
    }

    function evaluateConsent() {
        window.__adConsentGranted =
            window.OnetrustActiveGroups &&
            OnetrustActiveGroups.includes("C0004");

        window.__adConsentReady = true;
        initGPT();
    }

    window.addEventListener("OneTrustGroupsUpdated", function () {
        if(!window.__gptReady)
		{
            evaluateConsent();
		}
    });


</script>
<script nonce="33b66cfa-51f6-4124-8992-ba7ee8ec0ab0">
    window.renderAdSlot = function (slotId) {
        function run() {
            googletag.display(slotId);
        }

        if (window.__gptReady) {
            run();
            return;
        }

        window.__gptQueue.push(run);
    };
</script>



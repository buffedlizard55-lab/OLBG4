            <li v-for="(newsitem, index) in news">
                <div v-if="index === 0" class="atp_card small">
                    <a :href="lowercase(newsitem.url)" class="card-link" :class="{ 'card-link--video' : newsitem.videoId.length > 0 }" :data-video-id="newsitem.videoId" :data-account="newsitem.videoAccountId" :data-player="newsitem.videoPlayerId">
                        <div class="image-container">
                            <div class="image" :class="newsitem.videoId.length === 0 && newsitem.hasVideo ? 'image--video' : ''">
                                <img :src="newsitem.videoId.length > 0 ? `${newsitem.videoPosterImage}` : `${newsitem.image}`" :alt="newsitem.title">
                            </div>
                            <div v-if="newsitem.videoId.length > 0" class="cta">
                                <div class="cta-video">
                                    <svg viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" clip-rule="evenodd" d="M7.66634 4.99992L0.333008 9.66659V0.333252L7.66634 4.99992ZM5.17967 4.99992L1.66634 2.75992V7.23992L5.17967 4.99992Z" fill="white"></path>
                                    </svg>
                                </div>

            <div class="newsContent" v-for="(item, newsContent) in 3" :key="newsContent">
                <skeleton-loader type="block" :height="7.5" :border-radius=".5"></skeleton-loader>
                <div class="content">
                    <skeleton-loader type="label" size="small" :height="1.5"></skeleton-loader>
                    <skeleton-loader type="paragraph" :rows="3"></skeleton-loader>
                </div>
            </div>
        </div>
    </div>

    <template v-else>
        <div v-if="newsData.length > 0" class="header">
            <h3>Latest news</h3>
            <a href="/en/news/news-filter-results">View all<span class="icon-arrow-right2"></span></a>
        </div>
        <div v-if="newsData.length > 0" class="news">
            <div v-for="(newsContent, index) in newsData" class="news-content" :key="index">
                <div class="atp_card small" v-cloak>
                    <a :href="lowercase(`${newsContent.url}`)" class="card-link">
                        <div class="image-container">
                            <div class="image" :class="newsContent.videoId.length === 0 && newsContent.hasVideo ? 'image--video' : ''">
                                <img v-if="newsContent.videoId" :src="newsContent.image" :alt="newsContent.title" :title="newsContent.title">
                                <img v-else :src="newsContent.image" :alt="newsContent.title" :title="newsContent.title">

                            </div>
                            <div class="cta" v-if="newsContent.videoId">
                                <div class="cta-video">
                                    <svg viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path fill-rule="evenodd" clip-rule="evenodd"
                                              d="M7.66634 4.99992L0.333008 9.66659V0.333252L7.66634 4.99992ZM5.17967 4.99992L1.66634 2.75992V7.23992L5.17967 4.99992Z"
                                              fill="white"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <div class="content">
                            <div class="tag">{{newsContent.category}}</div>
                            <h3 class="title">{{newsContent.title}}</h3>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </template>


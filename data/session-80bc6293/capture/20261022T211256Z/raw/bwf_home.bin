<div class="title">PARTNERS</div>

<script>

    var $j = jQuery.noConflict();

    $j(document).ready(function () {

        // Get max partner logos.
        let partnersCount = 8;
        let logoCount = 0;
        let logoCountMid = 0;

        if (partnersCount >= 4) {
            logoCount = 4;
            logoCountMid = 3;
        } else {
            logoCount = partnersCount;
            logoCountMid = 2;
        }

        $j(".owl-partners").owlCarousel({
            loop: true,
            dots: false,
            nav: false,
            responsiveClass: true,
            responsiveRefreshRate: "50ms",
            responsive: {
                0: {
                    items: 1,
                    loop: true,
                    autoplay: true,
                    autoplayHoverPause: true,
                    autoplayTimeout: 7e3
                },
                600: {
                    items: logoCountMid,
                    loop: true,
                    autoplay: true,
                    autoplayHoverPause: true,
                    autoplayTimeout: 7e3
                },
                980: {
                    items: logoCount,
                    loop: true,
                    autoplay: true,
                    autoplayHoverPause: true,
                    autoplayTimeout: 7e3
                }
            }
        });
    });

</script>        </div>

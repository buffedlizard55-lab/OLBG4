                    releaseAdRequest();
                    return;
                }

                // failsafe: apstag can be blocked or slow, and its callback would
                // never fire, leaving every slot dark
                setTimeout(releaseAdRequest, BID_TIMEOUT);

                apstag.fetchBids({ slots: slots, timeout: BID_TIMEOUT }, releaseAdRequest);
            });
        }


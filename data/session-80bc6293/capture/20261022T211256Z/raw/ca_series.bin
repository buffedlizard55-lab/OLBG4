<script>
    window.googletag = window.googletag || { cmd: [] };

    googletag.cmd.push(function () {
        googletag.pubads().disableInitialLoad();
    });

    (function () {
        var BID_TIMEOUT = 2000;
        var released = false;

        // disableInitialLoad above means nothing renders until this runs, so every
        // exit path from the auction has to reach it exactly once
        function releaseAdRequest() {
            if (released) {
                return;
            }
            released = true;

            googletag.cmd.push(function () {
                if (window.apstag && typeof apstag.setDisplayBids === 'function') {
                    apstag.setDisplayBids();
                }
                googletag.pubads().refresh();
            });
        }

        function toApsSlot(slot) {
            // getSizes() with no arguments returns only the size passed to
            // defineSlot, not the sizes the slot's mapping allows at this width
            var sizes = (slot.getSizes(window.innerWidth, window.innerHeight) || slot.getSizes() || [])
                .filter(function (size) {
                    return size && typeof size.getWidth === 'function';
                })
                .map(function (size) {
                    return [size.getWidth(), size.getHeight()];
                });

            if (!sizes.length) {
                return null;
            }

            return {
                slotID: slot.getSlotElementId(),
                slotName: slot.getAdUnitPath(),
                sizes: sizes
            };
        }

        function requestBids() {
            googletag.cmd.push(function () {
                var slots = googletag.pubads().getSlots()
                    .map(toApsSlot)

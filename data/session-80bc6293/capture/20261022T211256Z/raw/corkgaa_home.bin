main.no-top-padding {
    padding-top: 0 !important;
}
.page-id-35944 .content{
    padding-top: 0px;
/*     padding-bottom: 0px; */
}
.page-id-10434 .content{
	  padding-top: 0px;
    padding-bottom: 0px;
}
.ticket-btn-stream{
    padding:12px 22px; 
	border:2px solid #B9021F !important; 
	color:#B9021F; font-weight:600; 
	border-radius:6px; display:flex; 
	align-items:center; gap:8px; 
	text-decoration:none;
}

.event-ticket-box {
    clear: both;
    display: block;
    width: 100%;
    margin-top: 30px !important;
    padding:20px; 
    border:1px solid #ddd; 
    background:#fff;
}
.clearboth{clear: both; width:100%;}
.event-ticket-box hr{margin:10px 0 20px;}

.ticket-btn-stream:hover{
    background: #B9021F !important;
    border-color: #B9021F !important;
    color: #ffffff !important;
}

.ticket-buttons{display:flex; gap:15px;}

elfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/news\",\"title\":\"News\",\"slug\":\"news\",\"neutralSlug\":\"news\",\"externalSourceName\":\"kinds\",\"externalSourceReference\":{\"SourceId\":\"100\",\"SourceName\":\"kinds\"},\"extraData\":{\"type\":\"Kind\",\"id\":\"100\"},\"fields\":{}},{\"_translationId\":\"c2cac090-0e11-4bb9-bd61-1912e130936a\",\"_entityId\":\"e1681653-e066-4666-b382-7095cc72d8d2\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/hurling\",\"title\":\"Hurling\",\"slug\":\"hurling\",\"neutralSlug\":\"hurling\",\"externalSourceReference\":{},\"extraData\":{\"bgColor\":\"#5D4777\",\"type\":\"badge\",\"fgColor\":\"#FFFFFF\",\"displayBadge\":true},\"fields\":{}}],\"createdBy\":\"John Harrington\",\"lastUpdatedBy\":\"John Harrington\",\"lastUpdatedDate\":\"2026-10-20T16:59:03.669Z\",\"contentDate\":\"2026-10-20T16:59:03.669Z\",\"featured\":0,\"summary\":\"By John Harrington\\nThe proposed rule enhancements drawn up by the GAA’s Hurling Expert Advisory Group (HEAG) will be properly road-tested for the first time this evening when UCD play Maynooth in Round 1 of the Higher Education Hurling League Division 1 at Belfield.\\nSome of the rule enhancements being\",\"thumbnail\":{\"slug\":\"3597974\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/photos/3597974\",\"title\":\"Hurling Expert Advisory Group Chair John Meyler, left, speaking alongside from left, National Head of Hurling William Maher, Hurling Expert Advisory Group member and former Wexford Camogie player Ursula Jacob, Hurling Expert Advisory Group member and former Offaly hurler Rory Hannify, Games Intelligence Unit representative, Dr. Michael McKay, and referee Chris Mooney during the Hurling Expert Advisory Group Trial Rule media briefing at Croke Park in Dublin. Photo by Sam Barnes/Sportsfile.\",\"templateUrl\":\"https://www.gaa.ie/api/images/image/private/{formatInstructions}/prd/szavxrlpwzucd8qjxewb\",\"thumbnailUrl\":\"https://www.gaa.ie/api/images/image/private/w_250,h_250,c_thumb,g_auto,q_auto,f_jpg/prd/szavxrlpwzucd8qjxewb\",\"format\":\"jpg\",\"overriddenFormats\":{}},\"type\":\"story\",\"url\":\"https://www.gaa.ie/article/trialling-of-hurling-rule-enhancements-begins\"},{\"_translationId\":\"bc16e6fb-020b-48bb-a683-68eea4116430\",\"_entityId\":\"2e4ef6a9-1744-4ec4-849a-1ebe1dd1e9b9\",\"slug\":\"mikey-butler-privileged-to-captain-irish-hurlers-against-scotland\",\"title\":\"Mikey Butler privileged to captain Irish hurlers against Scotland\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/stories/mikey-butler-privileged-to-captain-irish-hurlers-against-scotland\",\"tags\":[{\"_translationId\":\"45bcc5be-03c8-470a-9c25-08b68474ff80\",\"_entityId\":\"f9010331-ccf8-4d12-8de0-5142473de901\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/news\",\"title\":\"News\",\"slug\":\"news\",\"neutralSlug\":\"news\",\"externalSourceName\":\"kinds\",\"externalSourceReference\":{\"SourceId\":\"100\",\"SourceName\":\"kinds\"},\"extraData\":{\"type\":\"Kind\",\"id\":\"100\"},\"fields\":{}},{\"_translationId\":\"c2cac090-0e11-4bb9-bd61-1912e130936a\",\"_entityId\":\"e1681653-e066-4666-b382-7095cc72d8d2\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/hurling\",\"title\":\"Hurling\",\"slug\":\"hurling\",\"neutralSlug\":\"hurling\",\"externalSourceReference\":{},\"extraData\":{\"bgColor\":\"#5D4777\",\"type\":\"badge\",\"fgColor\":\"#FFFFFF\",\"displayBadge\":true},\"fields\":{}}],\"createdBy\":\"John Harrington\",\"lastUpdatedBy\":\"John Harrington\",\"lastUpdatedDate\":\"2026-10-20T14:11:33.604Z\",\"contentDate\":\"2026-10-20T14:09:28.549Z\",\"featured\":0,\"summary\":\"By John Harrington\\nMikey Butler will captain Ireland with pride in Saturday evening’s Hurling-Shinty International against Scotland in Supervalu Páirc Uí Chaoimh.\\nHe never imagined he’d ever even get to play the compromise code, so the opportunity to lead out his country is something the tenacious Kilkenny defender regards as\",\"thumbnail\":{\"slug\":\"3596349\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/photos/3596349\",\"title\":\"Mikey Butler poses for a portrait during the 2026 Ireland Hurling/Shinty photoshoot at the GAA National Games Development Centre in Abbotstown, Dublin. Photo by Piaras Ó Mídheach/Sportsfile\",\"templateUrl\":\"https://www.gaa.ie/api/images/image/private/{formatInstructions}/v1792504980/prd/t59xaglq4kfinxljm7nd\",\"thumbnailUrl\":\"https://www.gaa.ie/api/images/image/private/w_250,h_250,c_thumb,g_auto,q_auto,f_jpg/v1792504980/prd/t59xaglq4kfinxljm7nd\",\"format\":\"jpg\",\"overriddenFormats\":{}},\"type\":\"story\",\"url\":\"https://www.gaa.ie/article/mikey-butler-privileged-to-captain-irish-hurlers-against-scotland\"},{\"_translationId\":\"45753c30-287c-4b7b-86f6-f51e18fdd52b\",\"_entityId\":\"9fecf638-df38-4715-9dc7-025e0c770195\",\"slug\":\"adrian-mullen-excited-about-henry-shefflin-s-appointment-as-kilkenny-manager\",\"title\":\"Adrian Mullen excited about Henry Shefflin's appointment as Kilkenny manager\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/stories/adrian-mullen-excited-about-henry-shefflin-s-appointment-as-kilkenny-manager\",\"tags\":[{\"_translationId\":\"c2cac090-0e11-4bb9-bd61-1912e130936a\",\"_entityId\":\"e1681653-e066-4666-b382-7095cc72d8d2\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/hurling\",\"title\":\"Hurling\",\"slug\":\"hurling\",\"neutralSlug\":\"hurling\",\"externalSourceReference\":{},\"extraData\":{\"bgColor\":\"#5D4777\",\"type\":\"badge\",\"fgColor\":\"#FFFFFF\",\"displayBadge\":true},\"fields\":{}},{\"_translationId\":\"45bcc5be-03c8-470a-9c25-08b68474ff80\",\"_entityId\":\"f9010331-ccf8-4d12-8de0-5142473de901\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/news\",\"title\":\"News\",\"slug\":\"news\",\"neutralSlug\":\"news\",\"externalSourceName\":\"kinds\",\"externalSourceReference\":{\"SourceId\":\"100\",\"SourceName\":\"kinds\"},\"extraData\":{\"type\":\"Kind\",\"id\":\"100\"},\"fields\":{}},{\"_translationId\":\"ed44998c-1399-46c7-aeae-40fd3fd10459\",\"_entityId\":\"a3f49556-644b-4aaf-8dc4-6f18b4fb78f8\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/kilkenny\",\"title\":\"Kilkenny\",\"slug\":\"kilkenny\",\"neutralSlug\":\"kilkenny\",\"externalSourceName\":\"teams\",\"externalSourceReference\":{\"SourceId\":\"333ac5d9-0817-d691-1347-1fbb6e532161\",\"SourceName\":\"teams\"},\"extraData\":{\"bgColor\":\"#000000\",\"type\":\"county\",\"fgColor\":\"#fcbf00\",\"displayBadge\":true},\"fields\":{}},{\"_translationId\":\"879be1b2-4404-4d87-8800-17fbb421934e\",\"_entityId\":\"54bf52e8-2051-440c-b8b0-2db140e5a337\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/adrian-mullen\",\"title\":\"Adrian Mullen\",\"slug\":\"adrian-mullen\",\"neutralSlug\":\"adrian-mullen\",\"externalSourceReference\":{},\"fields\":{}}],\"createdBy\":\"Cian O'Connell\",\"lastUpdatedBy\":\"Cian O'Connell\",\"lastUpdatedDate\":\"2026-10-20T09:10:55.648Z\",\"contentDate\":\"2026-10-20T09:10:55.648Z\",\"featured\":0,\"summary\":\"By Cian O’Connell\\nIntrigue is always attached to the Kilkenny SHC Final. The 2026 edition, though, features two proud clubs, who have shared 41 titles between them. Ballyhale Shamrocks have collected 21, Tullaroan’s tally is 20, but they are getting ready for a first decider since 1994.\\nSo, Sunday’s showpiece\",\"thumbnail\":{\"slug\":\"dans1077\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/photos/dans1077\",\"title\":\"Pictured is AIB ambassador Adrian Mullen (Ballyhale Shamrocks) at the launch of the AIB GAA, LGFA, and Camogie All-Ireland Club Championships. As the first sponsor to support the four codes of Gaelic Games at a national level, this season, AIB continues to celebrate the players and people behind them who make club life so special.\",\"templateUrl\":\"https://www.gaa.ie/api/images/image/private/{formatInstructions}/prd/tlbr875bpxc1fgk00z2i\",\"thumbnailUrl\":\"https://www.gaa.ie/api/images/image/private/w_250,h_250,c_thumb,g_auto,q_auto,f_jpg/prd/tlbr875bpxc1fgk00z2i\",\"format\":\"jpg\",\"overriddenFormats\":{}},\"type\":\"story\",\"url\":\"https://www.gaa.ie/article/adrian-mullen-excited-about-henry-shefflin-s-appointment-as-kilkenny-manager\"},{\"_translationId\":\"cc81e162-0d90-4403-9a8e-ac8a0bcc9bd6\",\"_entityId\":\"fc241346-e9f0-4242-9b45-df472eaf3b11\",\"slug\":\"ireland-panels-announced-ahead-of-shinty-hurling-camogie-internationals\",\"title\":\"Ireland panels announced ahead of Shinty-Hurling/Camogie Internationals\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/stories/ireland-panels-announced-ahead-of-shinty-hurling-camogie-internationals\",\"tags\":[{\"_translationId\":\"45bcc5be-03c8-470a-9c25-08b68474ff80\",\"_entityId\":\"f9010331-ccf8-4d12-8de0-5142473de901\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/news\",\"title\":\"News\",\"slug\":\"news\",\"neutralSlug\":\"news\",\"externalSourceName\":\"kinds\",\"externalSourceReference\":{\"SourceId\":\"100\",\"SourceName\":\"kinds\"},\"extraData\":{\"type\":\"Kind\",\"id\":\"100\"},\"fields\":{}},{\"_translationId\":\"c2cac090-0e11-4bb9-bd61-1912e130936a\",\"_entityId\":\"e1681653-e066-4666-b382-7095cc72d8d2\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/hurling\",\"title\":\"Hurling\",\"slug\":\"hurling\",\"neutralSlug\":\"hurling\",\"externalSourceReference\":{},\"extraData\":{\"bgColor\":\"#5D4777\",\"type\":\"badge\",\"fgColor\":\"#FFFFFF\",\"displayBadge\":true},\"fields\":{}}],\"createdBy\":\"John Harrington\",\"lastUpdatedBy\":\"John Harrington\",\"lastUpdatedDate\":\"2026-10-19T13:03:53.334Z\",\"contentDate\":\"2026-10-19T12:18:11.865Z\",\"featured\":0,\"summary\":\"The panels for the 2026 Shinty-Hurling/Camogie Internationals have been announced ahead of this Saturday's double-header at SuperValu Páirc Uí Chaoimh.\\nAn Ireland camogie team will face their Scottish counterparts at 4pm, before the hurling side face Scotland at 6pm.\\nManagers Ger Manley (camogie) and Eamon O'Shea (hurling) have confirmed their\",\"thumbnail\":{\"slug\":\"3580802\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/photos/3580802\",\"title\":\"Ireland Shinty-Camogie team: Amy Lee (Cork), Aimie Nolan (Carlow), Anais Curran (Wexford), Aoife McDonald (Tyrone), Ashling Thompson (Cork), Ava Fitzgerald (Cork), Dearbhla Magee (Antrim), Emma Murphy (Cork), Gráinne McDonald (Tyrone), Isobel Sheehan (Cork), Laura Hayes (Cork), Maeve Clince (Meath), Naoise Hughes (Armagh), Rachael Walsh (Waterford), Rebecca Kelly (Carlow), Saoirse McCarthy (Cork), Shannagh Hegarty (Antrim), Sinéad Wylde (Dublin), Sophie O’Callaghan (Limerick).\",\"templateUrl\":\"https://www.gaa.ie/api/images/image/private/{formatInstructions}/prd/ispifkfwxe0quba6nycc\",\"thumbnailUrl\":\"https://www.gaa.ie/api/images/image/private/w_250,h_250,c_thumb,g_auto,q_auto,f_jpg/prd/ispifkfwxe0quba6nycc\",\"format\":\"jpg\",\"overriddenFormats\":{}},\"type\":\"story\",\"url\":\"https://www.gaa.ie/article/ireland-panels-announced-ahead-of-shinty-hurling-camogie-internationals\"},{\"_translationId\":\"7cd11043-ce85-4aef-9a30-7f779fc85665\",\"_entityId\":\"8118c784-ee22-4181-b2d7-8bb80b59f922\",\"slug\":\"movember-ahead-of-the-game-webinars-available-for-gaa-coaches\",\"title\":\"Movember Ahead of the Game webinars available for GAA coaches\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/stories/movember-ahead-of-the-game-webinars-available-for-gaa-coaches\",\"tags\":[{\"_translationId\":\"45bcc5be-03c8-470a-9c25-08b68474ff80\",\"_entityId\":\"f9010331-ccf8-4d12-8de0-5142473de901\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/tags/news\",\"title\":\"News\",\"slug\":\"news\",\"neutralSlug\":\"news\",\"externalSourceName\":\"kinds\",\"externalSourceReference\":{\"SourceId\":\"100\",\"SourceName\":\"kinds\"},\"extraData\":{\"type\":\"Kind\",\"id\":\"100\"},\"fields\":{}}],\"createdBy\":\"John Harrington\",\"lastUpdatedBy\":\"John Harrington\",\"lastUpdatedDate\":\"2026-10-19T09:36:41.887Z\",\"contentDate\":\"2026-10-19T09:36:41.887Z\",\"featured\":0,\"summary\":\"GAA coaches across the country are being encouraged to register for a series of free online webinars designed to help them support the mental health and wellbeing of their players.\\nThe Movember Ahead of the Game programme is offering a series of coach-specific online workshops this winter, providing coaches with\",\"thumbnail\":{\"slug\":\"3503841\",\"selfUrl\":\"https://dapi.gaa.ie/v2/content/en-ie/photos/3503841\",\"title\":\"Pictured at the launch of Movember Ahead of the Game Phase 4 2026 is GPA Chief Executive Tom Parsons, with, from left to right, are, from left to right, Declan Hannon, ambassador and former Limerick hurler; Martin Stackpoole, programme facilitator and former Kerry hurler; Leah McCaffrey, programme facilitator and Dublin ladies footballer; and Kevin McManamon, former Dublin footballer and Sports Psychologist; at Croke Park in Dublin. Since its launch in 2024, Movember Ahead of the Game has reached more than 17,000 participants through mental health literacy workshops delivered in 400+ GAA clubs across the island of Ireland. This year, the GAA and GPA are encouraging clubs across Ireland to take part in The Most Important Team Talk, continuing to raise awareness of the importance of mental fitness both on and off the pitch. For more details visit learning.gaa.ie/Movember Photo by Ramsey Cardy/Sportsfile\",\"templateUrl\":\"https://www.gaa.ie/api/images/image/private/{formatInstructions}/prd/xzd1zkl16ntbdtpwomkv\",\"thumbnailUrl\":\"https://www.gaa.ie/api/images/image/private/w_250,h_250,c_thumb,g_auto,q_auto,f_jpg/prd/xzd1zkl16ntbdtpwomkv\",\"format\":\"jpg\",\"overriddenFormats\":{}},\"type\":\"story\",\"url\":\"https://www.gaa.ie/article/movember-ahead-of-the-game-webinars-available-for-gaa-coaches\"}],\"videoGridAttribute\":{\"skipNr\":4,\"limitNr\":6,\"tags\":\"\",\"variables\":[{\"type\":\"keyValue\",\"key\":\"inc_header\",\"keyValue\":{\"value\":\"~/_library/_header_hp\",\"valueType\":\"string\"}},{\"type\":\"keyVal
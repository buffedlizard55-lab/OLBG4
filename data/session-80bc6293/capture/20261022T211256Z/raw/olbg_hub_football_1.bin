ti=f6274e42de0439462b55fa51acbe00771792703412934%3Aouk%3Agoogle-chrome%3Aunknown%3A116.0.0.0&bookie_name=_best_&client_type=desktop_website",tournaments:[{id:"0d4fdc88599f825e481818b92b9e38aaac81db1d",selection:"Bayern Munich",market_alias:"Win Tournament",odds:"7.00",american_odds:"600",fractional_odds:"6/1",event_start_unix_timestamp:1812211200,categoryUrl:"/betting-tips/Football/UEFA_Competitions/1",eventUrl:"/betting-tips/Football/UEFA_Competitions/Champions_League/UEFA_Champions_League_2026-27/1?event_id=2007154",leagueUrl:"/betting-tips/Football/UEFA_Competitions/Champions_League/1",event_name_alias:"UEFA Champions League 2026-27",menu_league:"Champions League",tv_channel_css:null,experts_count:0,vc_outcome_id:272341263,vc_sport_id:1,nap_tips:0,nap_tips_count:0,ew_tips:1,ew_tips_count:3,win_tips:2,win_tips_count:5,stars_rating:0,confidence:40,confidence_nap:0,confidence_ew:33,comments_count:0,expired:0,venue:null,address:null}],pageTitle:"Football Betting Tips Today – Free Predictions & Weekend Tips",pageDescription:"\u003Cp dir=\"ltr\">Football tips for today's and this weekend's matches, chosen by the OLBG community. With over 100 tipsters contributing to some matches, the OLBG army provides in-depth reasoning across more than 100 leagues worldwide to help you weigh up your bets.\u003C/p>\u003Cp dir=\"ltr\">Every prediction shows the number of winning tips, confidence percentage, star value rating and tipster comments, so you can judge each selection for yourself before deciding what to follow.\u003C/p>",pageType:"Categories or Leagues",megaMenu:[{title:"All Sports",url:"/betting-tips",type:"sport"},{title:"Horse Racing",url:"/betting-tips/Horse_Racing/2",type:"sport",breadcrumbIdx:"betting-tips-Horse_Racing",rank:1,items:void 0,sportId:2,hasItems:true},{title:"Football",url:"/betting-tips/Football/1",type:"sport",breadcrumbIdx:"betting-tips-Football",rank:2,items:void 0,sportId:1,hasItems:true},{title:"Tennis",url:"/betting-tips/Tennis/3",type:"sport",bread
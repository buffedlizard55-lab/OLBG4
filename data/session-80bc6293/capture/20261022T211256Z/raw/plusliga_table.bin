	<script type="text/javascript"  nonce="e262cf17446ba7a60028a217cb3e0fe4">
		var accountId = 1;
		var tournamentId = 53;
	</script>

	<script type="text/javascript"  nonce="e262cf17446ba7a60028a217cb3e0fe4">

	jQuery(window).on('load', function() {
		(function($, initText) {
            var accountId = 1;
            var tournamentId = 53;
			console.log(initText);

			//inicjalizacja zmiennych globalnych skryptu
			var standingsRS = {};
			var standingsTables = {};
			var standingsFilters = {};
			var hasFinalTable = false;
			var hasPlayOff = false;
			var tableHeaderCache = {}; 
			$('.pagecontent .overflow-auto .table-headers').each(function(i, el) {
				tableHeaderCache[$(el).attr('id')] = $(el).html();
			});
			
			//osadzenie wierszy tabel w obiekcie wg klucza, którym jest id terminu danego wiersza (np. 2-1-3 = nrFazy-nrGrupy-nrTerminu) oraz osadzenie samych tabel w obiekcie - identyfikator obiektu to `groupid` - id grupy, dla której jest dana tabela: "`nrFazy`_`nrGrupy`"
			$('table.rs-standings-table, div.final-standings-table, div.playoff-standings-table').each(function(i,el) {
				var table = {
					jhtml: $(el),
					groupid: $(el).attr('data-groupid')
				};

				standingsTables['data_'+i] = table;

				$(el).find('tbody tr').each(function(j,kel) {
					if (typeof standingsRS[$(kel).attr('data-termin')] == 'undefined')
						standingsRS[$(kel).attr('data-termin')] = [];
					standingsRS[$(kel).attr('data-termin')].push($(kel));
				});

				if (!hasFinalTable) {
					hasFinalTable = $(el).attr('data-groupid') == 'final' ? true : hasFinalTable;
				}

				if (!hasPlayOff) {
					hasPlayOff = $(el).attr('data-groupid') == 'playoff' ? true : hasPlayOff;
				}
			});

			//osadzenie filtrów w obiekcie; identyfikatory obiektu to `type` - typ filtra: 'faza', 'grupa', 'termin' oraz `faza` nr fazy (dla `type`='grupa' i `type`='termin') i `grupa` nr grupy (dla `type`='termin')
			$('#filterContent .filtr').each(function(i,el) {
				if ( ($(el).attr('data-type') == 'grupa' || $(el).attr('data-type') == 'termin') && !$(el).hasClass('disabled') ) {
					var height = $(el).first().outerHeight(true);

					$(el)
						//.removeClass('disabled')
						.parent()
							.css({
								height: height+"px"
							});
				}
				var filtr = {
					jhtml: $(el),
					type: $(el).attr('data-type')
				};
				if (filtr.type == "faza") {
				} else if (filtr.type == "grupa") {
					filtr.faza = $(el).attr('data-faza');
				} else if (filtr.type == "termin") {
					filtr.faza = $(el).attr('data-faza');
					filtr.grupa = $(el).attr('data-grupa');
				}
				standingsFilters[i] = filtr;
			});

			//zmiana wysokości kontenera filtrów jeśli potrzeba przy zmianie szerokości okna
			$( window ).resize(function(){
				console.log('resize');
				for (var key in standingsFilters) {
					if (standingsFilters.hasOwnProperty(key)) {
						if ( standingsFilters[key]['type'] == 'grupa' || standingsFilters[key]['type'] == 'termin' ) {
							
							if ( !standingsFilters[key]['jhtml'].hasClass('disabled') ) {

								var height = standingsFilters[key].jhtml.first().outerHeight(true);
								standingsFilters[key].jhtml
									.parent()
										.css({
											height: height+"px"
										});
							}
						}
					}
				}
			});

			//console.log('standingsRS',standingsRS);
			//console.log('standingsTables',standingsTables);
			//console.log('standingsFilters',standingsFilters);

			//oprogramowanie zdarzenia wyboru/kliknięcia filtra
			$('#filterContent a').on('click', function(e) {
				e.preventDefault();
				e.stopPropagation();
				
				if (!$(this).hasClass('disabled')) {
					var aBtn = this;

					//jeśli już aktywny, nie robimy nic
					if ($(aBtn).hasClass('active'))
						return;

					//zmiana aktywności przycisków w filtrze
					$(aBtn).addClass('active').siblings('.active').removeClass('active');
					
					//typ wybranego filtra: faza, grupa, termin
					var dataType = $(aBtn).attr('data-type');
					//identyfikator wybranego filtra
					var dataHref = $(aBtn).attr('data-href');
					//identyfikator wybranego filtra w postaci tablicy
					var dataHrefArr = dataHref.split('-');
					//console.log('dataHrefArr',dataHrefArr);
					//opcjonalny tytuł tabeli dla danego filtra
					var classificationLabel = $(aBtn).attr('data-classificationlabel');

					if (dataType == 'faza') {

						//nazwa filtra jeśli to faza
						var dataName = $(aBtn).attr('data-name');
						//console.log('dataName',dataName);

						var grupaIdArr = changePhaseFilter(standingsFilters, dataHrefArr);

						grupaIdArr = grupaIdArr ? grupaIdArr : dataHrefArr;
						//console.log('grupaIdArr', grupaIdArr);

						var terminData = changeGroupFilter(standingsFilters, grupaIdArr);

						if (dataName === 'standingsFinal') {
							toggleTables(standingsTables, false, 'final');
						} else if (dataName === 'playOff') {
							toggleTables(standingsTables, false, 'playoff');
						} else {
							var terminIdArr = terminData.terminIdArr;
							var terminId = terminData.terminId;
							var classificationLabel = terminData.classificationLabel;

							var groupid = false;
							if (terminIdArr) {
								groupid = terminIdArr[0]+'_'+terminIdArr[1];

								changeTerminInTable(standingsRS, terminIdArr, terminId);

								toggleTables(standingsTables, terminIdArr, groupid, classificationLabel);
							}
						}							
					} else if (dataType == 'grupa') {
						var terminData = changeGroupFilter(standingsFilters, dataHrefArr);
						var terminIdArr = terminData.terminIdArr;
						var terminId = terminData.terminId;
						var classificationLabel = terminData.classificationLabel;

						var groupid = false;
						if (terminIdArr) {
							groupid = terminIdArr[0]+'_'+terminIdArr[1];

							changeTerminInTable(standingsRS, terminIdArr, terminId);

							toggleTables(standingsTables, terminIdArr, groupid, classificationLabel);
						}
					} else if (dataType == 'termin') {
						var groupid = dataHrefArr[0]+'_'+dataHrefArr[1];

						changeTerminInTable(standingsRS, dataHrefArr, dataHref);

						toggleTables(standingsTables, dataHrefArr, groupid, classificationLabel);

					}
				}
			});

			//zmiana filtra grupy i terminu wg klikniętej fazy w filtrze
			var changePhaseFilter = function(standingsFilters, dataHrefArr) {
				var grupaIdArr = false;
				for (var key in standingsFilters) {
					if (standingsFilters.hasOwnProperty(key)) {
						
						if ( standingsFilters[key]['type'] == 'grupa' && standingsFilters[key]['faza'] == dataHrefArr[0] ) {

							grupaIdArr = standingsFilters[key].jhtml.find('a.active').attr('data-href').split('-');

							var height = standingsFilters[key].jhtml.first().outerHeight(true);
							standingsFilters[key].jhtml
								.removeClass('disabled')
								.parent()
									.css({
										height: height+"px"
									});
						} else if (standingsFilters[key]['type'] == 'grupa') {

							standingsFilters[key].jhtml
								.addClass('disabled')
								.parent()
									.css({
										height: '0px'
									});
						}
					}
				}

				return grupaIdArr;
			};

			//zmiana filtra terminu wg klikniętej grupy w filtrze
			var changeGroupFilter = function(standingsFilters, grupaIdArr) {
				var terminIdArr = false;
				var terminId = false;
				var classificationLabel = false;
				for (var key in standingsFilters) {
					if (standingsFilters.hasOwnProperty(key)) {
						
						if (standingsFilters[key]['type'] == 'termin') {

							if (grupaIdArr && standingsFilters[key]['faza'] == grupaIdArr[0] && (standingsFilters[key]['grupa'] == grupaIdArr[1] || typeof grupaIdArr[1] == 'undefined')) {

								terminId = standingsFilters[key].jhtml.find('a.active').attr('data-href');
								terminIdArr = terminId.split('-');
								classificationLabel = standingsFilters[key].jhtml.find('a.active').attr('data-classificationlabel');

								var height = standingsFilters[key].jhtml.first().outerHeight(true);
								standingsFilters[key].jhtml
									.removeClass('disabled')
									.parent()
										.css({
											height: height+"px"
										});
							} else {
								standingsFilters[key].jhtml
									.addClass('disabled')
									.parent()
										.css({
											height: '0px'
										});
							}
						}
					}
				}

				return {
					terminIdArr: terminIdArr,
					terminId: terminId,
					classificationLabel: classificationLabel
				};
			};

			//zmiana terminu w tabeli wg wybranego filtra
			var changeTerminInTable = function(standingsRS, terminIdArr, terminId) {
				var counter = 0;
				for (var key in standingsRS) {
					if (standingsRS.hasOwnProperty(key)) {
						var keyArr = key.split('-');
						if (terminIdArr[0] == keyArr[0] && terminIdArr[1] == keyArr[1]) {

							//console.log('key',key);
							//console.log('terminId',terminId);
							if (key == terminId) {
								
								//var oddClass = "";
								standingsRS[key].forEach(function(element, index, array) {
									counter++;
									element.removeClass('hidden');
									if ( counter % 2 ) {
										element.addClass('trodd');
									} else {
										element.removeClass('trodd');
									}
								});
							} else {
								standingsRS[key].forEach(function(element, index, array) {
									element.addClass('hidden').removeClass('trodd');
								});
							}
						}
					}
				}
			};

			//zmiana tabeli wg wybranej grupy w filtrze
			var toggleTables = function(standingsTables, terminIdArr, groupid, classificationLabel) {
				//console.log('terminIdArr', terminIdArr);
				//console.log('groupid', groupid);
				//console.log('standingsTables', standingsTables);

				for (var key in standingsTables) {
					if (standingsTables.hasOwnProperty(key)) {

						if ( groupid && standingsTables[key]['groupid'] == groupid ) {
							standingsTables[key]['jhtml'].closest('.overflow-auto')
								.css({
									display: ''
								})
								//.find('.table-header-termin').text(terminIdArr[2])
								;

							if (groupid !== 'final' && groupid !== 'playoff') {
								
								$parent = standingsTables[key]['jhtml'].closest('.overflow-auto').parent();
								var table_header_id = 'table-header-'+terminIdArr[0]+'-'+terminIdArr[1];
								var table_header = $parent.find('#'+table_header_id);
								if (typeof classificationLabel === 'string' && classificationLabel.length) {
									table_header.text(classificationLabel);
								} else {
									table_header.html(tableHeaderCache[table_header_id]);
									table_header.find('.table-header-termin').text(terminIdArr[2]);
								}
							}
						} else {
							standingsTables[key]['jhtml'].closest('.overflow-auto')
								.css({
									display: 'none'
								})
								;
						};
					}
				}
			};


			var showLastTable = function() {
				var fazaFilters = $('#filterContent a[data-type="faza"]');

				if (fazaFilters.length > 1) {
					fazaFilters.last().click();
				} else {
					var terminFilters = $('#filterContent a[data-type="termin"]').filter(".active");
					var tablesContent = $('#toggle-tabs-disabled');
					terminFilters.each(function(i, el) {
						var qEl = $(el);
						var classificationLabel = qEl.attr('data-classificationlabel');
						if (typeof classificationLabel === 'string' && classificationLabel.length) {
							var terminIdArr = qEl.attr('data-href').split('-');
							var table_header_id = 'table-header-'+terminIdArr[0]+'-'+terminIdArr[1];
							var table_header = tablesContent.find('#'+table_header_id);
							table_header.text(classificationLabel);
						}
					});
				}
			};

				showLastTable();

		})(jQuery, 'start aplikacji GAME STANDINGS');
	});

</script>
	</div>
</section>

	
<section class="no-top">
	<div class="container content">
	
			<p><strong>Faza zasadnicza, klasyfikacja generalna - uwzględnia wyniki wszystkich rozegranych mecz&oacute;w, łącznie z meczami rozegranymi awansem. Punktacja: 3 pkt za wygraną 3:0 i 3:1, 2 pkt za wygraną 3:2, 1 pkt za porażkę 2:3, 0 pkt za przegrane 1:3 i 0:3.</strong></p>
<p>Kolejność w tabeli po każdej kolejce rozgrywek ustalana jest według liczby zdobytych punkt&oacute;w meczowych. W przypadku r&oacute;wnej liczby punkt&oacute;w meczowych o wyższym miejscu w tabeli decyduje:</p>
<ol style="list-style-type: lower-alpha;">
<li>liczba wygranych mecz&oacute;w,</li>
<li>lepszy (wyższy) stosunek set&oacute;w zdobytych do straconych,</li>
<li>lepszy (wyższy) stosunek małych punkt&oacute;w zdobytych do małych punkt&oacute;w straconych.</li>
</ol>
<p>Jeżeli mimo zastosowania powyższych reguł nadal nie można ustalić kolejności, o wyższej pozycji w tabeli decydują wyniki mecz&oacute;w rozegranych pomiędzy zainteresowanymi drużynami w danym sezonie.<br /><br /></p>
<p><strong>System rozgrywek TAURON Ligi &ndash; sezon 2026/2027 (14 drużyn)</strong></p>
<p>Rozgrywki obejmują dwie fazy:</p>
<p><strong>1. Faza zasadnicza:</strong> Dwie rundy rozgrywane systemem &bdquo;każdy z każdym - mecz i rewanż&rdquo; z udziałem 14 drużyn.</p>
<p><strong>2. Faza play-off:</strong> Liczba rund dostosowana do systemu rozgrywek obowiązującego w danym sezonie.</p>
<ul>
<li><strong>Runda 1. - o miejsca 1-8:</strong><br /> O tytuł mistrza Polski grają drużyny, kt&oacute;re po zakończeniu fazy zasadniczej rozgrywek zajęły w tabeli miejsca od 1 do 8. Drużyny z miejsc 1-8; 2-7; 3-6; 4-5 utworzą pary meczowe, kt&oacute;re zagrają do dw&oacute;ch wygranych mecz&oacute;w ze zmianą gospodarza po każdym meczu. Gospodarzami pierwszych spotkań będą zespoły, kt&oacute;re po fazie zasadniczej rozgrywek zajęły wyższe miejsce w tabeli.</li>
<li><strong>Runda 2. - o miejsca 1-4:</strong><br /> Zwycięzcy rywalizacji z rundy 1. zagrają w 1/2 finału o miejsca 1-4. W pierwszym p&oacute;łfinale zagrają zwycięzca rywalizacji 1-8 ze zwycięzcą rywalizacji 4-5. W drugim p&oacute;łfinale zagrają zwycięzca rywalizacji 2-7 ze zwycięzcą rywalizacji 3-6. Drużyny grają do dw&oacute;ch wygranych mecz&oacute;w ze zmianą gospodarza po każdym meczu. Gospodarzami pierwszych spotkań będą zespoły, kt&oacute;re po fazie zasadniczej rozgrywek zajęły wyższe miejsce w tabeli.</li>
<li><strong>Runda 3. - o miejsca 5-6:</strong><br /> Dwie przegrane drużyny z pierwszej rundy fazy play-off (wyżej sklasyfikowane po zakończeniu fazy zasadniczej) rywalizować będą o miejsca 5-6. Drużyny grają do dw&oacute;ch wygranych mecz&oacute;w ze zmianą gospodarza po każdym meczu. Gospodarzem pierwszego spotkania będzie zesp&oacute;ł, kt&oacute;ry po fazie zasadniczej rozgrywek zajął wyższe miejsce w tabeli.</li>
<li><strong>Runda 3. - o miejsca 3-4:</strong><br /> Przegrany 1. p&oacute;łfinału gra z przegranym 2. p&oacute;łfinału, do trzech wygranych mecz&oacute;w ze zmianą gospodarza po każdym meczu. Gospodarzem pierwszego spotkania będzie zesp&oacute;ł, kt&oacute;ry po fazie zasadniczej rozgrywek zajął wyższe miejsce w tabeli.</li>
<li><strong>Runda 3. - o miejsca 1-2 i tytuł mistrza Polski:</strong><br /> Zwycięzca 1. p&oacute;łfinału gra ze zwycięzcą 2. p&oacute;łfinału do trzech wygranych mecz&oacute;w ze zmianą gospodarza po każdym meczu. Gospodarzem pierwszego spotkania będzie zesp&oacute;ł, kt&oacute;ry po fazie zasadniczej rozgrywek zajął wyższe miejsce w tabeli.</li>
</ul>
<p><strong>UWAGA:</strong></p>
<ul>
<li>Drużyny, kt&oacute;re po zakończeniu fazy zasadniczej zajmą miejsca 9-14 kończą rozgrywki na miejscach 9-14.</li>
<li>Dwie przegrane drużyny z pierwszej rundy fazy play off (niżej sklasyfikowane po zakończeniu fazy zasadniczej) kończą rozgrywki na miejscach 7-8.</li>
<li>Drużyna, kt&oacute;ra po zakończeniu fazy zasadniczej zajmie ostatnie miejsce traci uprawnienia do udziału w rozgrywkach TAURON Ligi od sezonu 2027/2028.</li>
</ul>
<p><strong>GRAJĄ:</strong> (numery oznaczają miejsca w tabeli po fazie zasadniczej)</p>
<ul>
<li><strong>miejsca 1-8</strong><br />A) 1 z 8<br />B) 2 z 7<br />C) 3 z 6<br />D) 4 z 5</li>
<li><strong>miejsca 1-4</strong><br />E) zwycięzca A - zwycięzca D<br />F) zwycięzca B - zwycięzca C</li>
<li><strong>miejsca 5-6</strong><br />I) przegrany A lub B lub C lub D - przegrany A lub B lub C lub D</li>
<li><strong>miejsca 3-4</strong><br />J) przegrany E - przegrany F</li>
<li><strong>miejsca 1-2</strong><br />L) zwycięzca E - zwycięzca F</li>
</ul>
	

  "reverse_engineering_findings": [
    {
      "id": "RE-01",
      "title": "20-Card Top-Level Feed Truncation Hidden Behind Competition Sub-Feeds",
      "detail": "OLBG's top-level sport pages (/betting-tips/{Sport}/{id}) cap initial server HTML rendering at ~20 event cards sorted by tip volume. Probing competition sub-feeds (/Basketball/NBA/4, /Basketball/European/4, /Basketball/European/Euroleague/4, /Basketball/Other/4, /Ice_Hockey/NHL/13, /Ice_Hockey/Other/13) uncovered 17 additional live OLBG fixtures hidden from top-level feeds plus 11 newly posted fixtures across Snooker, Volleyball, Handball, and Rugby Union (28 live OLBG fixtures missed by single-page crawlers)."
    },
    {
      "id": "RE-02",
      "title": "Complete 24-Slot Numeric Sport Router (IDs 1..28) & Correction of Prior Taxonomy Bug",
      "detail": "Numeric sport IDs control OLBG's backend query while URL slugs are cosmetic labels. Prior repo artifact data/olbg-structure.json misidentified ID 17 as 'Aussie Rules' because /Aussie_Rules/17 returned Cycling's currently empty tip shell. Probing all IDs 1..28 + /best-tipsters + /sitemap-betting-tips.xml proved: ID 6 = Specials (excluded), ID 17 = Cycling (excluded), ID 22 = Aussie Rules (in-scope, 0 live tips), ID 23 = eSports (in-scope, 0 live tips across /CSGO/23, /DOTA2/23, /LOL/23, /Other_eSports/23), ID 26 = Hurling (excluded, 2 live events), ID 28 = Greyhounds (in-scope, 6 live races), and IDs 18, 19, 24, 27 are unassigned."
    },
    {
      "id": "RE-03",
      "title": "EDT (UTC-4) Display Timestamps Without Explicit Timezone Suffix",
      "detail": "Event cards on OLBG render timestamps in US Eastern Daylight Time (EDT = UTC-4) with no timezone indicator (e.g., NBA 7:10 PM ET renders as '22 Oct 19:10', UK Greyhounds 11:14 BST render as '21 Oct 06:14', European 20:45 CEST fixtures render as '14:45'). Treating raw OLBG clock strings as UTC caused systematic 4-hour kickoff errors in earlier repository builds."
    },
    {
      "id": "RE-04",
      "title": "Active Major Sporting Events Missing Entirely From OLBG Feeds",
      "detail": "Official calendar verification proved three live international championships running in October 2026 have zero match coverage on OLBG: Rugby League World Cup 2026 (15 Oct \u2013 15 Nov 2026, Australia/PNG/NZ), 2026 League of Legends World Championship Swiss Stage (23\u201331 Oct 2026, Allen, Texas), and 2026 NAB AFLW Round 11 (23\u201325 Oct 2026)."
    }
  ],
